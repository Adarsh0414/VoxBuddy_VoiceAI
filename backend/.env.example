# Copy this file to .env in the backend/ folder and fill in real values.
# python-dotenv loads it automatically (see app.py) — no export commands needed.
# Nothing here is required to run the app; every provider defaults to a
# mock so the demo/dev flow always works with zero keys. Set a provider
# switch + its key to turn a piece from fake to real.

# ---- Translation (Bedrock is the default; Gemini/Claude are optional) ----
# Turns on real, context-aware translation instead of the "[en] ..." mock.
# VOXBUDDY_TRANSLATION_PROVIDER defaults to "bedrock" even if left unset,
# since it's the AWS-native option and reuses the AWS_* credentials below
# (no separate key needed) — appropriate given the rest of this app's
# AWS-first pipeline (Polly, Transcribe, DynamoDB). Provider selection is
# explicit: if Bedrock is misconfigured, translation fails loudly rather
# than silently falling back to another provider.
VOXBUDDY_TRANSLATION_PROVIDER=gemini
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Requires the AWS credentials in the "AWS integration" section below,
# plus bedrock:InvokeModel IAM permission scoped to BEDROCK_MODEL_ID —
# see docs/AWS_INTEGRATION.md for the exact policy statement. Also
# requires the model to be enabled for your account/region under the
# Bedrock console's "Model access" page.

# --- OR, to use your own Gemini API key instead (optional/secondary) ---
#   VOXBUDDY_TRANSLATION_PROVIDER=gemini
#   GEMINI_API_KEY=<your key>
GEMINI_API_KEY=

# --- OR, Anthropic's direct API instead of Bedrock (optional) ---
#   VOXBUDDY_TRANSLATION_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=<your key>
ANTHROPIC_API_KEY=

# ---- Speech-to-text (AssemblyAI) ------------------------------------------
# Now on aws_transcribe (see AWS integration section below for the extra
# IAM permission this needs) instead of assemblyai. ASSEMBLYAI_API_KEY
# below is now UNUSED with this provider set — left in place only in case
# you want to switch back for an A/B comparison (see docs/vendor_decision.md
# §1); safe to delete if you don't.
VOXBUDDY_ASR_PROVIDER=
ASSEMBLYAI_API_KEY=

# ---- Text-to-speech ---------------------------------------------------------
# Now on polly (AWS-native, uses the AWS_* credentials below — no separate
# account/billing relationship) instead of elevenlabs. ELEVENLABS_API_KEY
# below is now UNUSED with this provider set — left in place in case you
# want to switch back; safe to delete if you don't.
VOXBUDDY_TTS_PROVIDER=polly
ELEVENLABS_API_KEY=

# ---- AWS integration (Polly TTS + DynamoDB history + Transcribe ASR) -----
# VoxBuddy's AWS-native pipeline stages. Requires an IAM user with
# polly:SynthesizeSpeech (TTS), dynamodb:* on tables prefixed by
# DYNAMODB_TABLE_PREFIX (history), and transcribe:StartStreamTranscription
# (real-time ASR, needed now that VOXBUDDY_ASR_PROVIDER=aws_transcribe
# above) — see docs/AWS_INTEGRATION.md for the exact IAM policy JSON,
# which must include all three actions.
#
# DynamoDB tables (voxbuddy_conversations/turns/counters) are created
# automatically on startup (persistence_dynamodb.init_db()) — no manual
# table-creation step needed, just the IAM permission to create them.
#
# VOXBUDDY_PERSISTENCE_PROVIDER=dynamodb below turns on DynamoDB instead
# of the SQLite default for conversation history/stats.
#
# To stream cie/eval.py's metrics (confidence, bystander-rejection rate,
# switch accuracy, latency) live to CloudWatch instead of only printing
# them:
#   VOXBUDDY_CLOUDWATCH_METRICS=true
# Off by default — the eval harness just prints its report as before.
# Uses the same AWS credentials below, plus an optional custom namespace:
VOXBUDDY_CLOUDWATCH_METRICS=false
VOXBUDDY_CLOUDWATCH_NAMESPACE=VoxBuddy/CIE

# To opt in to logging anonymized CIE signal tuples to S3 — the
# calibration data flywheel for eventually tuning cie/engine.py's
# hand-set fusion weights against real data (see cie/calibration_log.py
# and cie/calibration.py):
#   VOXBUDDY_CALIBRATION_LOGGING=true
#   VOXBUDDY_CALIBRATION_BUCKET=your-bucket-name
# Off by default. Never logs raw audio, text, embeddings, or any
# identifier — only the CIE's numeric signal breakdown and its decision.
VOXBUDDY_CALIBRATION_LOGGING=false
VOXBUDDY_CALIBRATION_BUCKET=
VOXBUDDY_CALIBRATION_PREFIX=signal-tuples

# All AWS integrations (Polly, DynamoDB, CloudWatch, S3 calibration
# logging, Transcribe) share the same credentials below — boto3 reads
# these environment variables automatically, no extra VoxBuddy-specific
# key. NOTE: these look like real, live credentials — rotate them in the
# IAM console if this .env has ever left your machine (e.g. shared,
# uploaded, or committed anywhere), since a leaked key/secret pair is
# usable by anyone who has it until it's deactivated.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=voxbuddy

# Now on dynamodb instead of the sqlite default for conversation
# history/stats (see the AWS integration comment above).
VOXBUDDY_PERSISTENCE_PROVIDER=dynamodb

# ---- Optional: OTP delivery -----------------------------------------------
# Without any of this, OTP codes print to the server console instead of
# being emailed/texted — fine for local testing, not for real users.
#
# Email and SMS are configured independently — you don't need the same
# vendor for both. Pick ONE option per channel:
#
#   Email: "brevo" (needs BREVO_API_KEY) or "smtp" (direct send via
#          Gmail/Outlook/any mail server — no third-party account beyond
#          the mailbox you already have; for Gmail use an App Password,
#          not your normal password)
#   SMS:   "brevo" (needs BREVO_API_KEY + a separate SMS add-on enabled
#          on your Brevo account — see app.brevo.com/transactional/sms)
#          or "fast2sms" (needs VOXBUDDY_FAST2SMS_API_KEY — India-focused,
#          free trial credit on signup, no separate add-on purchase)
VOXBUDDY_OTP_EMAIL_PROVIDER=brevo
VOXBUDDY_OTP_SMS_PROVIDER=fast2sms

# -- If using "brevo" for either channel above --
VOXBUDDY_BREVO_API_KEY=
VOXBUDDY_BREVO_SENDER_EMAIL=

# -- If using "smtp" for email above --
VOXBUDDY_SMTP_HOST=smtp.gmail.com
VOXBUDDY_SMTP_PORT=465
VOXBUDDY_SMTP_USERNAME=
VOXBUDDY_SMTP_PASSWORD=

# -- If using "fast2sms" for SMS above --
VOXBUDDY_FAST2SMS_API_KEY=

# Your real deployed backend URL (e.g. after Render step E) — only used to
# embed the real app logo image in OTP emails. Email clients can't load
# images from localhost, so without this the email still looks intentional,
# just with a text wordmark instead of the logo PNG.
VOXBUDDY_PUBLIC_URL=

# ---- Optional: /ws/{session_id}/audio connection-lifecycle guard ---------
# Bounds real-time ASR vendor cost from a forgotten/backgrounded/stuck
# connection: closes the audio WebSocket if no final transcribed turn
# arrives for VOXBUDDY_WS_IDLE_TIMEOUT_SECONDS, or unconditionally once
# VOXBUDDY_WS_MAX_SESSION_SECONDS total connection time is reached.
# Independent of VOXBUDDY_ASR_PROVIDER (behaves the same under mock,
# assemblyai, aws_transcribe). Both already have sane defaults in
# app.py (100s / 1800s) — uncomment only if you want different values.
# VOXBUDDY_WS_IDLE_TIMEOUT_SECONDS=100
# VOXBUDDY_WS_MAX_SESSION_SECONDS=1800

# ---- Optional: Redis-backed auth sessions ---------------------------------
# Leave this commented out unless you're actually running a Redis server.
# Uncommenting VOXBUDDY_SESSION_STORE=redis with no real Redis reachable at
# REDIS_URL will make every login fail with a connection error — the
# default (this section left blank/commented) uses SQLite instead, which
# needs no setup and is what local dev and every test uses.
# VOXBUDDY_SESSION_STORE=redis
# REDIS_URL=redis://localhost:6379/0

# ---- Optional: Google Sign-In (alongside email/phone OTP, not replacing it)
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application. Add both your
# local dev URL (http://localhost:8000) and your real deployed URL to
# "Authorized JavaScript origins" once you have one.
GOOGLE_CLIENT_ID=
# Required for the native Android app's sign-in flow (Google's JS SDK
# cannot run inside an embedded WebView, so the app uses a real
# authorization-code exchange instead, which needs this secret). Get it
# from the same OAuth client in Google Cloud Console -> Client secrets.
# Also add https://<your-render-url>/api/auth/google/callback under
# "Authorized redirect URIs" on that same client.
GOOGLE_CLIENT_SECRET=