# Single-instance EB environments still get their own security group
# (AWSEBSecurityGroup) even with no load balancer in front — this just
# adds the inbound 443 rule to it. Port 80 is already open by EB's
# default security group config (needed anyway for Let's Encrypt's
# HTTP-01 challenge in the postdeploy hook).
Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      ToPort: 443
      FromPort: 443
      CidrIp: 0.0.0.0/0
