# Installs certbot into its own venv (isolated from the app's Python
# environment), so .platform/hooks/postdeploy/00_get_certificate.sh can
# request/renew a free, publicly-trusted Let's Encrypt certificate.
#
# Why this exists at all: a single-instance Elastic Beanstalk environment
# has no load balancer, so an ACM certificate (which only plugs into an
# ELB/ALB/CloudFront) cannot be used here. TLS has to terminate on the
# instance's own nginx, which means a real, non-self-signed certificate —
# Let's Encrypt is the standard free option, and is trusted by Android and
# by Google's OAuth flow, unlike a self-signed one.
#
# ignoreErrors: true on each step so a rerun (every deploy runs these
# again) doesn't fail just because a package/venv/symlink already exists.
container_commands:
  00_install_deps:
    command: "sudo dnf install -y python3 augeas-libs"
    ignoreErrors: true
  10_create_venv:
    command: "sudo python3 -m venv /opt/certbot"
    ignoreErrors: true
  20_update_pip:
    command: "sudo /opt/certbot/bin/pip install --upgrade pip"
    ignoreErrors: true
  30_install_certbot:
    command: "sudo /opt/certbot/bin/pip install certbot certbot-nginx"
    ignoreErrors: true
  40_link_certbot:
    command: "sudo ln -sf /opt/certbot/bin/certbot /usr/bin/certbot"
    ignoreErrors: true
